<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kompa">

        <activity
            android:name=".ui.inicio.InicioActivity"
            android:exported="true"
            android:theme="@style/Theme.Kompa">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.registro.RegistroActivity"
            android:exported="false"
            android:parentActivityName=".ui.inicio.InicioActivity"
            android:theme="@style/Theme.Kompa" />

        <activity
            android:name=".ui.auth.login.LoginActivity"
            android:exported="false"
            android:parentActivityName=".ui.inicio.InicioActivity"
            android:theme="@style/Theme.Kompa" />

        <activity
            android:name=".ui.auth.recuperar.RecuperarContrasenaActivity"
            android:exported="false"
            android:parentActivityName=".ui.auth.login.LoginActivity"
            android:theme="@style/Theme.Kompa" />

        <activity
            android:name=".ui.perfil.preview.PerfilPreviewActivity"
            android:exported="false"
            android:parentActivityName=".ui.auth.registro.RegistroActivity"
            android:theme="@style/Theme.Kompa" />

        <activity
            android:name=".ui.perfil.confirmacion.ConfirmacionActivity"
            android:exported="false"
            android:theme="@style/Theme.Kompa" />

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Kompa" />

        <activity
            android:name=".ui.nueva.NuevaActividadActivity"
            android:exported="false"
            android:parentActivityName=".ui.home.HomeActivity"
            android:theme="@style/Theme.Kompa" />

        <activity
            android:name=".ui.lista.ListaActividadesActivity"
            android:exported="false"
            android:parentActivityName=".ui.home.HomeActivity"
            android:theme="@style/Theme.Kompa" />

    </application>

</manifest>