<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".PerfilPreviewActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/tv_titulo_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Así se verá tu perfil"
            android:textColor="@color/purple_dark"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Revisa que todo esté correcto antes de confirmar"
            android:textColor="@color/gray_text"
            android:textSize="14sp" />

        <!-- Foto de perfil -->
        <ImageView
            android:id="@+id/iv_foto_perfil_preview"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_profile_circle"
            android:padding="30dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="@color/purple_medium"
            android:contentDescription="Foto de perfil" />

        <!-- Nombre -->
        <TextView
            android:id="@+id/tv_nombre_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal"
            android:textColor="@color/text_dark"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="María Torres" />

        <!-- Correo -->
        <TextView
            android:id="@+id/tv_correo_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:textColor="@color/gray_text"
            android:textSize="13sp"
            tools:text="maria@correo.com" />

        <!-- Tarjeta de datos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@color/purple_ultra_light"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_fecha_nacimiento_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                tools:text="Nacimiento: 12/05/2000" />

            <TextView
                android:id="@+id/tv_nacionalidad_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                tools:text="Nacionalidad: Colombiana" />

            <TextView
                android:id="@+id/tv_genero_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                tools:text="Género: Mujer" />

            <TextView
                android:id="@+id/tv_conectar_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                tools:text="Conectar con: Mujeres, Todes" />
        </LinearLayout>

        <!-- Idiomas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Idiomas"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_idiomas_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- Intereses -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Intereses"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_intereses_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- Botones -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bt_confirmar_perfil"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/purple_primary"
            android:text="Confirmar perfil"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bt_editar_perfil"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="Editar información"
            android:textAllCaps="false"
            android:textColor="@color/purple_primary"
            android:textSize="15sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
