<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="40dp">

        <!-- Título -->
        <TextView
            android:id="@+id/tv_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crea tu cuenta"
            android:textColor="@color/purple_dark"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tv_subtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Encuentra a tu próximo grupo de viaje o amistad"
            android:textColor="@color/gray_text"
            android:textSize="14sp" />

        <!-- Foto de perfil -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp">

            <ImageView
                android:id="@+id/iv_foto_perfil"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_profile_circle"
                android:padding="30dp"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="@color/purple_medium"
                android:contentDescription="Foto de perfil" />

            <ImageView
                android:id="@+id/bt_agregar_foto"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_camera_button"
                android:padding="8dp"
                android:src="@android:drawable/ic_input_add"
                app:tint="@color/white"
                android:contentDescription="Agregar foto"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_ayuda_foto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="Toca para subir tu foto"
            android:textColor="@color/purple_primary"
            android:textSize="12sp" />

        <!-- Nombre -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_nombre"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Nombre completo"
            app:boxStrokeColor="@color/purple_primary"
            app:hintTextColor="@color/purple_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Correo -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_correo"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Correo electrónico"
            app:boxStrokeColor="@color/purple_primary"
            app:hintTextColor="@color/purple_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_correo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Contraseña -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_password"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Contraseña"
            app:boxStrokeColor="@color/purple_primary"
            app:hintTextColor="@color/purple_primary"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Fecha de nacimiento -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_fecha_nacimiento"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Fecha de nacimiento"
            app:boxStrokeColor="@color/purple_primary"
            app:hintTextColor="@color/purple_primary"
            app:endIconMode="custom"
            app:endIconDrawable="@android:drawable/ic_menu_my_calendar"
            app:endIconTint="@color/purple_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_fecha_nacimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Nacionalidad -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_nacionalidad"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Nacionalidad"
            app:boxStrokeColor="@color/purple_primary"
            app:hintTextColor="@color/purple_primary">

            <AutoCompleteTextView
                android:id="@+id/actv_nacionalidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Idiomas que hablas -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_idiomas"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Idiomas que hablas"
            app:boxStrokeColor="@color/purple_primary"
            app:hintTextColor="@color/purple_primary">

            <AutoCompleteTextView
                android:id="@+id/actv_idiomas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_ayuda_idiomas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/gray_text"
            android:textSize="12sp" />

        <!-- Género -->
        <TextView
            android:id="@+id/tv_label_genero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Género"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_genero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_mujer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/purple_primary"
                android:text="Mujer" />

            <RadioButton
                android:id="@+id/rb_hombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/purple_primary"
                android:text="Hombre" />

            <RadioButton
                android:id="@+id/rb_no_binario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/purple_primary"
                android:text="No binario" />

            <RadioButton
                android:id="@+id/rb_otro_genero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/purple_primary"
                android:text="Prefiero describirlo" />
        </RadioGroup>

        <!-- Con quién quiere conectar -->
        <TextView
            android:id="@+id/tv_label_conectar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="¿Con quién quieres conectar?"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_conectar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_mujeres"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mujeres"
                app:chipBackgroundColor="@color/purple_ultra_light"
                app:chipStrokeColor="@color/purple_medium"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_hombres"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hombres"
                app:chipBackgroundColor="@color/purple_ultra_light"
                app:chipStrokeColor="@color/purple_medium"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_todes"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todes"
                app:chipBackgroundColor="@color/purple_ultra_light"
                app:chipStrokeColor="@color/purple_medium"
                app:chipStrokeWidth="1dp" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Intereses -->
        <TextView
            android:id="@+id/tv_label_intereses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Tus intereses"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_contador_intereses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Elige hasta 5 (0/5)"
            android:textColor="@color/gray_text"
            android:textSize="12sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_intereses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="false">

            <!-- Los chips de interés se agregan dinámicamente desde Kotlin,
                 ver INTERESES_DISPONIBLES en MainActivity.kt -->

        </com.google.android.material.chip.ChipGroup>

        <!-- Botón registrarse -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bt_registrar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/purple_primary"
            android:text="Crear cuenta"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp" />

        <CheckBox
            android:id="@+id/cb_datos_personales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:buttonTint="@color/purple_primary"
            android:text="Acepto el tratamiento de mis datos personales conforme a la Política de Privacidad"
            android:textColor="@color/gray_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_terminos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="Al registrarte aceptas nuestros Términos y Condiciones y Política de Privacidad"
            android:textAlignment="center"
            android:textColor="@color/gray_text"
            android:textSize="11sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>